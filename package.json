{
  "name": "ai-interviewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server --import ./scripts/load-env.ts scripts/worker.ts",
    "lint": "eslint",
    "db:migrate": "tsx --import ./scripts/load-env.ts scripts/migrate.ts",
    "recordings:backfill": "tsx --conditions=react-server --import ./scripts/load-env.ts scripts/recordings-backfill.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "playwright test -c tests/seed/playwright.config.ts",
    "admin:grant": "tsx --import ./scripts/load-env.ts scripts/platform-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@base-ui/react": "^1.8.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@hookform/resolvers": "^5.9.1",
    "@vladmandic/face-api": "1.7.15",
    "bullmq": "^6.5.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "next": "16.3.7",
    "openai": "^7.25.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
