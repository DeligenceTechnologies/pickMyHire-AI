# --- Database -------------------------------------------------------------
# Any PostgreSQL 14+ database. For Supabase use the project's direct
# connection string (Settings -> Database). Must NOT be a superuser role,
# otherwise Row Level Security is bypassed.
DATABASE_URL=

# --- Supabase (optional; used when STORAGE_DRIVER=supabase) ---------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage --------------------------------------------------------------
# Where resumes and interview recordings are stored: local | supabase | r2 | s3
#   local    -> files on disk (development only)
#   supabase -> Supabase Storage (needs NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY)
#   r2       -> Cloudflare R2 (needs R2_*; free egress, recommended at scale)
#   s3       -> AWS S3 or any S3-compatible store (needs S3_*)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.storage
SUPABASE_STORAGE_BUCKET=interview-private

# Cloudflare R2: dashboard -> R2 -> Manage API tokens (Object Read & Write on the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AWS S3 / S3-compatible (S3_ENDPOINT only for non-AWS providers, e.g. MinIO)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Background jobs (recording processing) ---------------------------------
# Redis for the BullMQ queue. Run the worker with `npm run worker`.
# Unset = recordings are encoded inside the web server (fine for local dev only).
REDIS_URL=
# Video quality of the playable MP4 (18-35, lower = better + bigger). 27 suits interviews.
RECORDING_CRF=27
# Hours to keep the raw upload chunks after the MP4 is verified, then delete them.
RECORDING_CHUNK_RETENTION_HOURS=24
# Recordings encoded at the same time per worker (each runs one ffmpeg).
RECORDING_WORKER_CONCURRENCY=1
# Optional: use a system ffmpeg instead of the bundled one.
FFMPEG_PATH=

# --- Security -------------------------------------------------------------
# 32+ random bytes, used to sign storage URLs. `openssl rand -hex 32`
APP_SECRET=

# --- OpenAI (server-side only) --------------------------------------------
OPENAI_API_KEY=
# Optional model overrides (see lib/ai/config.ts for defaults)
OPENAI_MODEL_FAST=
OPENAI_MODEL_REASONING=
OPENAI_MODEL_REALTIME=
OPENAI_MODEL_TRANSCRIBE=
OPENAI_REALTIME_VOICE=
# auto | openai | mock   (auto = openai when OPENAI_API_KEY is set, else mock)
AI_PROVIDER=auto

# --- App --------------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Email (optional) --------------------------------------------------------
# log | resend
EMAIL_PROVIDER=log
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Required to create new workspaces (give to approved customers). Unset = invite-only.
SIGNUP_ACCESS_CODE=
